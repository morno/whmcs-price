# ==============================================================================
# .distignore
# Files and directories excluded from the wp.org SVN release.
# Format follows .gitignore syntax.
# ==============================================================================

# Version control
.git
.gitignore
.gitattributes
.github

# AI agent skills (developer tooling, not runtime)
.claude
.cursor
.agents
skills-lock.json

# Developer documentation
docs
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
wordpress-7.1-compatibility.md

# Node / build tooling
node_modules
package.json
package-lock.json
yarn.lock
webpack.config.js
.babelrc

# PHP tooling
composer.json
composer.lock
vendor
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan.neon.dist

# Editor / OS
.editorconfig
.eslintrc
.eslintrc.js
.eslintrc.json
.prettierrc
.prettierrc.js
.prettierrc.json
.idea
.vscode
.DS_Store
Thumbs.db

# Distignore itself and dev-only distribution artifacts
.distignore
