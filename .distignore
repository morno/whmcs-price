# ==============================================================================
# .distignore
#
# Files and directories excluded from the wordpress.org SVN release.
# Read by 10up/action-wordpress-plugin-deploy and equivalent tooling.
# Syntax follows .gitignore rules.
#
# Anything in this list is present in the GitHub repo but stripped out before
# the plugin is packaged for wp.org, so end users only get runtime files.
# ==============================================================================

# ---- Version control ---------------------------------------------------------
.git
.gitignore
.gitattributes
.github

# ---- Community health files (GitHub-only) ------------------------------------
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md

# ---- AI agent skills (developer tooling, not runtime) ------------------------
.claude
.cursor
.agents
skills-lock.json

# ---- Developer documentation -------------------------------------------------
# readme.txt is the user-facing changelog on wp.org and stays.
# CHANGELOG.md is linked from readme.txt to the GitHub copy, so exclude it.
CHANGELOG.md
docs

# ---- Build tooling: Node -----------------------------------------------------
node_modules
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
webpack.config.js
.babelrc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Build tooling: PHP ------------------------------------------------------
composer.json
composer.lock
vendor
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan.neon.dist
.phpunit.result.cache

# ---- Editor / IDE / OS -------------------------------------------------------
.editorconfig
.eslintrc
.eslintrc.js
.eslintrc.json
.prettierrc
.prettierrc.js
.prettierrc.json
.stylelintrc
.stylelintrc.js
.stylelintrc.json
.idea
.vscode
.DS_Store
Thumbs.db

# ---- Local development environments -----------------------------------------
.wp-env
.wp-env.json
.env
.env.local
.env.*.local

# ---- Local secrets -----------------------------------------------------------
webServerAPISettings.json

# ---- Build scripts and release artifacts ------------------------------------
build.sh
build.ps1
bin
build_temp
*.zip

# ---- Distignore itself -------------------------------------------------------
.distignore
