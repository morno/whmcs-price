{
	"name": "morno/whmcs-price",
	"description": "Development tooling for Mornolink for WHMCS. Not required at runtime - the plugin ships without Composer dependencies.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5 || ^11.5",
		"brain/monkey": "^2.6"
	},
	"autoload-dev": {
		"psr-4": {
			"WHMCS_Price\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "find . -path ./vendor -prune -o -path ./node_modules -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
	},
	"config": {
		"sort-packages": true,
		"platform-check": false
	}
}
