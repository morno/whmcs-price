{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "whmcs-price/product",
	"version": "2.8.0",
	"title": "WHMCS Product Price",
	"category": "widgets",
	"icon": "tag",
	"description": "Display real-time product pricing from your WHMCS instance.",
	"keywords": [
		"whmcs",
		"price",
		"product",
		"hosting"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"text": true,
			"background": true,
			"link": false
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"pid": {
			"type": "string",
			"default": ""
		},
		"billingCycle": {
			"type": "string",
			"default": "1y"
		},
		"show": {
			"type": "array",
			"default": [
				"name",
				"price"
			],
			"items": {
				"type": "string"
			}
		},
		"displayStyle": {
			"type": "string",
			"default": "table"
		},
		"perPeriod": {
			"type": "string",
			"default": ""
		},
		"cycleToggle": {
			"type": "boolean",
			"default": false
		},
		"toggleCycles": {
			"type": "array",
			"default": [
				"1m",
				"1y"
			],
			"items": {
				"type": "string"
			}
		},
		"currency": {
			"type": "string",
			"default": ""
		},
		"preview": {
			"type": "boolean",
			"default": false
		}
	},
	"example": {
		"viewportWidth": 800,
		"attributes": {
			"preview": true,
			"displayStyle": "cards",
			"show": [
				"name",
				"price",
				"description"
			]
		}
	},
	"textdomain": "whmcs-price",
	"editorScript": "file:../build/whmcs-price-product.js",
	"editorStyle": "file:../build/whmcs-price-product.css",
	"style": "file:../build/whmcs-price-product.css",
	"viewScript": [],
	"render": "file:./render.php"
}
